<?xml version="1.0" encoding="utf-8"?>
<!-- iOS CallKit compact banner: product line + @tag left; Decline (X) / Answer (✓) right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/incoming_call_glass_bg"
    android:gravity="center_vertical"
    android:minHeight="@dimen/incoming_call_glass_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/incoming_call_glass_pad_start"
    android:paddingTop="@dimen/incoming_call_glass_pad_vertical"
    android:paddingEnd="@dimen/incoming_call_glass_pad_end"
    android:paddingBottom="@dimen/incoming_call_glass_pad_vertical">

    <!-- Caller avatar: drawn on this phone from the verified tag (never downloaded). -->
    <ImageView
        android:id="@+id/incoming_call_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/incoming_call_text_to_actions"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Flat product mark (blue ring + B). Not @mipmap/ic_launcher —
                 AdaptiveIcon safe-zone crops the ring and center B. -->
            <ImageView
                android:id="@+id/incoming_call_app_icon"
                android:layout_width="@dimen/incoming_call_app_icon"
                android:layout_height="@dimen/incoming_call_app_icon"
                android:contentDescription="@string/app_name"
                android:scaleType="fitXY"
                android:src="@drawable/incoming_call_app_icon" />

            <TextView
                android:id="@+id/incoming_call_product_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/incoming_call_product_icon_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/incoming_call_glass_subtitle"
                android:textColor="@color/incoming_call_product_line"
                android:textSize="12.5sp"
                android:textStyle="normal" />
        </LinearLayout>

        <TextView
            android:id="@+id/incoming_call_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/incoming_call_title_top"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/incoming_call_body"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incoming_call_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFF453A"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/incoming_call_decline"
        android:layout_width="@dimen/incoming_call_action_size"
        android:layout_height="@dimen/incoming_call_action_size"
        android:background="@drawable/incoming_call_decline_circle"
        android:contentDescription="@string/incoming_call_decline"
        android:elevation="2dp"
        android:padding="@dimen/incoming_call_action_icon_pad"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_incoming_call_close"
        android:stateListAnimator="@null" />

    <ImageButton
        android:id="@+id/incoming_call_answer"
        android:layout_width="@dimen/incoming_call_action_size"
        android:layout_height="@dimen/incoming_call_action_size"
        android:layout_marginStart="@dimen/incoming_call_action_gap"
        android:background="@drawable/incoming_call_answer_circle"
        android:contentDescription="@string/incoming_call_answer"
        android:elevation="2dp"
        android:padding="@dimen/incoming_call_action_icon_pad"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_incoming_call_check"
        android:stateListAnimator="@null" />
</LinearLayout>
