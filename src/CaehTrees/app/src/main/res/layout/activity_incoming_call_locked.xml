<?xml version="1.0" encoding="utf-8"?>
<!--
  Lock-screen incoming call, same flow as iOS: full screen, "Beamio Audio"
  product line, caller, wallet capsule, Decline, then Slide to answer.
  The unlocked banner (activity_incoming_call) keeps the same ids for the
  shared views so caller refreshes reach either layout.
-->
<!-- fitsSystemWindows replaces the root's own padding with system insets,
     so the content padding lives on the inner column. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_in_call_gradient"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="40dp"
    android:paddingEnd="28dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/incoming_call_app_icon"
            android:layout_width="@dimen/incoming_call_app_icon"
            android:layout_height="@dimen/incoming_call_app_icon"
            android:contentDescription="@string/app_name"
            android:scaleType="fitXY"
            android:src="@drawable/incoming_call_app_icon" />

        <TextView
            android:id="@+id/incoming_call_product_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/incoming_call_product_icon_gap"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/incoming_call_glass_subtitle"
            android:textColor="@color/incoming_call_product_line"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Caller avatar: drawn on this phone from the verified tag (never downloaded). -->
    <ImageView
        android:id="@+id/incoming_call_avatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/incoming_call_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/incoming_call_body"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/incoming_call_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#FFFF453A"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/incoming_call_address_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_in_call_eoa_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_in_call_wallet"
            android:tint="@color/in_call_eoa_accent" />

        <TextView
            android:id="@+id/incoming_call_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/in_call_eoa_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/incoming_call_decline"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_in_call_end"
        android:contentDescription="@string/incoming_call_decline"
        android:padding="20dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_in_call_end" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:text="@string/incoming_call_decline"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp" />

    <com.beamio.app.BeamioSlideToAnswerView
        android:id="@+id/incoming_call_slide"
        android:layout_width="match_parent"
        android:layout_height="72dp" />
</LinearLayout>
</FrameLayout>
