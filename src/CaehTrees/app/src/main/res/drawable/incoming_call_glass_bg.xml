<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- White-based frosted glass. The cool edge is only a sheen, not a dark mask. -->
    <gradient
        android:angle="0"
        android:centerColor="#B3FFFFFF"
        android:endColor="#99E7F1FF"
        android:startColor="#D9FFFFFF"
        android:type="linear" />
    <corners android:radius="32dp" />
    <stroke
        android:width="1.5dp"
        android:color="#F2FFFFFF" />
</shape>
