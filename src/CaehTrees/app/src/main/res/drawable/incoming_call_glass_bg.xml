<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Dark charcoal banner at 85% opacity (alpha D9 ≈ 0.85), matching dual-window mock. -->
    <solid android:color="@color/incoming_call_banner" />
    <!-- Match iOS CallKit compact banner silhouette (~13pt continuous → 14dp circular). -->
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
