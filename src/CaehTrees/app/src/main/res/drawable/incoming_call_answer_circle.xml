<?xml version="1.0" encoding="utf-8"?>
<!-- Metallic blue accept: outer rim + inset face (CSS icon-btn accept). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:centerColor="@color/incoming_call_answer_rim_mid"
                android:endColor="@color/incoming_call_answer_rim_end"
                android:startColor="@color/incoming_call_answer_rim_start"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="1.2dp"
        android:left="1.2dp"
        android:right="1.2dp"
        android:top="1.2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:centerColor="@color/incoming_call_answer_face_mid"
                android:endColor="@color/incoming_call_answer_face_end"
                android:startColor="@color/incoming_call_answer_face_start"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
