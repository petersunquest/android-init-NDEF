# CaehTrees release signing follows android-NDEF:
# use sibling Android-init-NDEF keystore (do not commit secrets).
#
# Source of truth:
#   ../Android-init-NDEF/keystore.properties
#   ../Android-init-NDEF/beamio-app-release.keystore
#
# Local override (optional): copy this file to keystore.properties in CaehTrees
# only if you need a different upload key — default Gradle wiring ignores this
# and reads Android-init-NDEF instead.

# Example shape (Android-init-NDEF):
# storePassword=…
# keyPassword=…
# keyAlias=beamio-app
# storeFile=beamio-app-release.keystore
