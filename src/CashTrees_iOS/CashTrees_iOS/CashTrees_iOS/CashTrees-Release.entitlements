<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<!-- Production APS for Distribution / Ad Hoc installs. AuthKey
	     7GXMG42Y6P delivers on api.push.apple.com for production tokens;
	     development-signed builds fail sandbox with BadEnvironmentKeyInToken. -->
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:beamio.app</string>
		<string>applinks:www.beamio.app</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
